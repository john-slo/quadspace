# ============================================================================
# Quadspace Docker Environment Configuration
# Copy this to .env or .env.prod and configure for your environment
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================

# Aspnetcore environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Aspnetcore URLs (internal to container)
ASPNETCORE_URLS=http://+:8080

# Scores directory inside container
Scores__Directory=/app/scores

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level for default logger
# Values: Trace, Debug, Information, Warning, Error, Critical, None
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

# ============================================================================
# ASP.NET Core Configuration
# ============================================================================

# Enable forwarded headers (behind proxy like nginx)
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# ============================================================================
# Docker Runtime Configuration
# ============================================================================

# Skip first-run experience
DOTNET_SKIP_FIRST_RUN=true

# Running in container
DOTNET_RUNNING_IN_CONTAINER=true

# Globalization invariant mode (set to false for locale support)
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# ============================================================================
# Security Configuration
# ============================================================================

# Session timeout in minutes (example value)
SessionTimeout=30

# Enable HTTPS redirect
EnableHttpsRedirect=false

# Content Security Policy (example)
ContentSecurityPolicy=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline';

# ============================================================================
# Production Only
# ============================================================================

# Resource limits (Docker only)
MEMORY_LIMIT=512M
CPU_LIMIT=1

# Replica count (for orchestration)
REPLICAS=1

# Health check URL
HEALTH_CHECK_URL=http://localhost:8080/api/scores/top

# ============================================================================
# Development Only
# ============================================================================

# Watch for code changes (when using dotnet watch)
DOTNET_WATCH_RESTART_ON_RUDE_EDIT=true

# Enable developer exception pages
EnableDeveloperExceptionPages=true

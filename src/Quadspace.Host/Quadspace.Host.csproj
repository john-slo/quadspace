<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Quadspace.Core\Quadspace.Core.csproj" />
    <ProjectReference Include="..\Quadspace.Client\Quadspace.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ensure static web asset placeholders in index.html are replaced with actual fingerprints -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Don't fingerprint the index.html itself so the placeholder replacement works -->
    <StaticWebAssetOnBuildManifest>false</StaticWebAssetOnBuildManifest>
  </PropertyGroup>

</Project>

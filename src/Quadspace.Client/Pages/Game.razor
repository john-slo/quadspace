@page "/game"
<PageTitle>quadspace</PageTitle>

<div class="game-shell">
    <canvas @ref="_canvas" class="game-canvas" width="@_width" height="@_height"></canvas>

    <footer class="game-controls">
        <a class="game-exit" href="">◄ HOME</a>
        <div class="controls-legend">
            <span>MOVE <b>W A S D</b></span>
            <span>FIRE <b>&uarr; &darr; &larr; &rarr;</b></span>
            <span>SOUND <b>M</b> <span id="sound-state">--</span></span>
            <span>SFX <b>N</b> <span id="sfx-state">--</span></span>
        </div>
    </footer>

    @if (_gameOver)
    {
        <dialog class="gameover" open>
            <h1 class="neon-title">GAME OVER</h1>
            <p class="neon-subtitle">SCORE @_finalScore.ToString("N0")</p>
            <EditForm Model="this" OnValidSubmit="SubmitScoreAsync">
                <input class="name-input" 
                       maxlength="50" 
                       placeholder="ENTER NAME (A-Z, 0-9, spaces, hyphens, apostrophes)"
                       @bind="_playerName" 
                       @bind:event="oninput" 
                       disabled="@_submitting"
                       aria-label="Player name" />
                <button class="start-link" type="submit" disabled="@_submitting">
                    @(_submitting ? "SAVING…" : "SAVE SCORE")
                </button>
            </EditForm>
            @if (_submitError is not null)
            {
                <p class="submit-error" role="alert">@_submitError</p>
            }
        </dialog>
    }
</div>
